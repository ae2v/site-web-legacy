generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String?
  firstName String
  lastName String
  role Role @default(MEMBRE)
  pole String?
  roleTitle String?
  departement String @default("GEII")
  niveau String @default("BUT1")
  contributionStatus ContributionStatus @default(NON_COTISANT)
  membershipStatus MembershipStatus @default(DEMANDE_SOUMISE)
  cardCode String @unique
  contributionCents Int @default(0)
  memberSince String?
  requestedAt String?
  validatedAt String?
  schoolYear String @default("2026-2027")
  emailPrefs String[] @default(["newsletter"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  tickets Ticket[]
}
model Dossier {
  id String @id @default(cuid())
  firstName String
  lastName String
  email String @unique
  departement String
  niveau String
  status MembershipStatus @default(DEMANDE_SOUMISE)
  contributionStatus ContributionStatus @default(NON_COTISANT)
  submittedAt String
  validatedAt String?
  notes String?
  createdAt DateTime @default(now())
}
model Event {
  id String @id @default(cuid())
  title String
  slug String @unique
  kind String @default("Soirée")
  date String
  place String
  capacity Int @default(100)
  registered Int @default(0)
  status EventStatus @default(OUVERT)
  waitlist Boolean @default(false)
  registrationOpensAt String?
  description String
  image String?
  pricePublicCents Int @default(0)
  priceMemberCents Int @default(0)
  tiersJson String @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets Ticket[]
}
model Ticket {
  id String @id @default(cuid())
  eventId String
  userId String?
  userEmail String
  code String @unique
  tier String
  priceCents Int
  status String @default("valide")
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}
model Product {
  id String @id @default(cuid())
  name String
  tagline String
  priceMemberCents Int
  pricePublicCents Int
  badge String?
  image String?
  sizesJson String @default("[]")
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Order {
  id String @id @default(cuid())
  userId String?
  userEmail String
  customerName String
  date String
  totalCents Int
  status String @default("EN_PREPARATION")
  linesJson String @default("[]")
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
}
model Invoice {
  id String @id @default(cuid())
  date String
  customerName String
  customerEmail String
  paymentMethod String
  priceCents Int
  description String
  createdAt DateTime @default(now())
}
model TeamMember {
  id String @id @default(cuid())
  displayName String
  roleTitle String
  pole String
  personalAe2vEmail String @unique
  roleEmail String?
  isOfficer Boolean @default(false)
  bio String?
  photoUrl String?
  mandateYear String @default("2026-2027")
  createdAt DateTime @default(now())
}
model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  sujet String
  message String
  status String @default("NON_LU")
  sentAt String
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  action String
  details String
  author String @default("Système")
  timestamp DateTime @default(now())
}
enum Role {
  MEMBRE
  BUREAU
  TRESORIER
  PRESIDENT
}
enum MembershipStatus {
  DEMANDE_SOUMISE
  MEMBRE_VALIDE
  REFUSE
}
enum ContributionStatus {
  NON_COTISANT
  PAIEMENT_EN_ATTENTE
  PAYEE
}
enum EventStatus {
  NON_PUBLIE
  OUVERT
  COMPLET
  BIENTOT
  TERMINE
}
